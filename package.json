{
  "name": "nodrift",
  "version": "0.1.0",
  "description": "Verify that deployed smart contract state matches a YAML config. Drift detection for EVM chains, built for CI.",
  "keywords": [
    "ethereum",
    "evm",
    "smart-contracts",
    "drift-detection",
    "verification",
    "monitoring",
    "multicall",
    "ci",
    "junit",
    "solidity"
  ],
  "homepage": "https://github.com/devjoinedthechat/nodrift#readme",
  "bugs": {
    "url": "https://github.com/devjoinedthechat/nodrift/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devjoinedthechat/nodrift.git"
  },
  "license": "MIT",
  "author": "Nodrift contributors",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./nodrift.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "nodrift": "dist/cli.js"
  },
  "files": [
    "dist",
    "nodrift.schema.json",
    "examples",
    "templates"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{js,mjs}\"",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:e2e": "jest tests/e2e",
    "test:coverage": "jest --coverage",
    "schema": "tsx scripts/generate-schema.ts",
    "fixtures": "bash scripts/build-fixtures.sh",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "commander": "^15.0.0",
    "ethers": "^6.17.0",
    "js-yaml": "^4.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
