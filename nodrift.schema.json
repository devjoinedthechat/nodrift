{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/devjoinedthechat/nodrift/main/nodrift.schema.json",
  "title": "nodrift configuration",
  "description": "Expected on-chain state for nodrift. Generated from src/config/schema.ts; do not edit by hand.",
  "type": "object",
  "properties": {
    "version": {
      "type": [
        "number",
        "string"
      ]
    },
    "network": {
      "$ref": "#/definitions/Network"
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "templates": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "contracts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/definitions/Contract"
      }
    }
  },
  "required": [
    "network",
    "contracts"
  ],
  "additionalProperties": false,
  "definitions": {
    "Network": {
      "type": "object",
      "properties": {
        "rpc_url": {
          "type": "string",
          "minLength": 1,
          "description": "HTTP(S) JSON-RPC endpoint"
        },
        "chain_id": {
          "description": "Expected chain id. Checked against the endpoint before any read.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^(\\d+|\\$\\{[^}]+\\})$"
            }
          ]
        },
        "block": {
          "description": "Block to read at (default: latest). Resolved once so every check sees the same state.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "latest",
                "safe",
                "finalized"
              ]
            },
            {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^(\\d+|\\$\\{[^}]+\\})$"
                }
              ]
            }
          ]
        },
        "timeout": {
          "description": "Per-request timeout in milliseconds (default 30000)",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^(\\d+|\\$\\{[^}]+\\})$"
            }
          ]
        },
        "max_retries": {
          "description": "Retries for transient RPC errors (default 3)",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^(\\d+|\\$\\{[^}]+\\})$"
            }
          ]
        },
        "multicall": {
          "description": "Batch calls through Multicall3 when deployed (default true)",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "^(true|false|\\$\\{[^}]+\\})$"
            }
          ]
        }
      },
      "required": [
        "rpc_url",
        "chain_id"
      ],
      "additionalProperties": false
    },
    "Contract": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "abi": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            {
              "type": "string",
              "description": "Path to an ABI or Foundry/Hardhat artifact JSON file"
            }
          ]
        },
        "preset": {
          "type": "string",
          "enum": [
            "erc20",
            "erc721",
            "erc1155",
            "erc4626",
            "diamond",
            "proxy",
            "accessControl"
          ]
        },
        "template": {
          "type": "string"
        },
        "network": {
          "allOf": [
            {
              "$ref": "#/definitions/Network"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/StateEntry"
              }
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/definitions/StateEntry"
              }
            }
          ]
        }
      },
      "required": [
        "address",
        "state"
      ],
      "additionalProperties": false
    },
    "StateEntry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "owner"
            },
            "value": {
              "type": "string"
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "role"
            },
            "role": {
              "type": "string",
              "minLength": 1,
              "description": "Role name (hashed with keccak256), DEFAULT_ADMIN_ROLE, or a bytes32 hash"
            },
            "account": {
              "description": "Check hasRole(role, account) against a boolean `value`",
              "type": "string"
            },
            "value": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "pattern": "^(true|false|\\$\\{[^}]+\\})$"
                }
              ]
            },
            "members": {
              "description": "Exact member set. Requires AccessControlEnumerable.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type",
            "role"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "variable"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Public variable or zero-argument getter"
            },
            "value": {
              "description": "Expected value. Typed against the ABI output type."
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "function_call"
            },
            "function": {
              "type": "string",
              "minLength": 1,
              "description": "Function name from the ABI, or a signature such as \"balanceOf(address) returns (uint256)\""
            },
            "args": {
              "type": "array",
              "items": {},
              "description": "Function arguments"
            },
            "field": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ],
              "description": "Output to select from a multi-value return: a named output or a zero-based index"
            },
            "value": {
              "description": "Expected value. Typed against the ABI output type."
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type",
            "function"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "storage_slot"
            },
            "slot": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "slot_name": {
              "type": "string",
              "enum": [
                "IMPLEMENTATION_SLOT",
                "ADMIN_SLOT",
                "BEACON_SLOT"
              ]
            },
            "value": {
              "description": "Expected value. Typed against the ABI output type."
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "proxy"
            },
            "checks": {
              "type": "object",
              "properties": {
                "implementation": {
                  "type": "string"
                },
                "admin": {
                  "type": "string"
                },
                "beacon": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type",
            "checks"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "array_state"
            },
            "function": {
              "type": "string",
              "minLength": 1,
              "description": "Function returning an array"
            },
            "args": {
              "type": "array",
              "items": {},
              "description": "Function arguments"
            },
            "checks": {
              "type": "object",
              "properties": {
                "length": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "pattern": "^(\\d+|\\$\\{[^}]+\\})$"
                    }
                  ]
                },
                "contains": {
                  "type": "array",
                  "items": {}
                },
                "not_contains": {
                  "type": "array",
                  "items": {}
                },
                "exact": {
                  "type": "array",
                  "items": {}
                }
              },
              "additionalProperties": false
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type",
            "function",
            "checks"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "mapping_state"
            },
            "function": {
              "type": "string",
              "minLength": 1,
              "description": "Mapping getter"
            },
            "keys": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "description": "Mapping key, or a list of keys for nested mappings"
                  },
                  "value": {
                    "description": "Expected value. Typed against the ABI output type."
                  }
                },
                "required": [
                  "key",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type",
            "function",
            "keys"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cross_contract"
            },
            "target_contract": {
              "type": "string",
              "description": "Name of another contract in this config"
            },
            "function": {
              "type": "string",
              "minLength": 1,
              "description": "Function name from the ABI, or a signature such as \"balanceOf(address) returns (uint256)\""
            },
            "args": {
              "type": "array",
              "items": {},
              "description": "Function arguments"
            },
            "field": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ],
              "description": "Output to select from a multi-value return: a named output or a zero-based index"
            },
            "value": {
              "description": "Expected value. Typed against the ABI output type."
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type",
            "target_contract",
            "function"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "aggregate"
            },
            "operation": {
              "type": "string",
              "enum": [
                "sum",
                "count",
                "average",
                "min",
                "max"
              ]
            },
            "sources": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/Source"
              }
            },
            "value": {
              "description": "Expected value. Typed against the ABI output type."
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type",
            "operation",
            "sources"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "comparison"
            },
            "left": {
              "$ref": "#/definitions/Source"
            },
            "operator": {
              "type": "string",
              "enum": [
                "==",
                "!=",
                ">",
                ">=",
                "<",
                "<=",
                "equals",
                "not_equals",
                "greater_than",
                "greater_than_or_equal",
                "less_than",
                "less_than_or_equal"
              ]
            },
            "right": {
              "$ref": "#/definitions/Source"
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type",
            "left",
            "operator",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "time_based"
            },
            "function": {
              "type": "string",
              "minLength": 1,
              "description": "Function returning a unix timestamp"
            },
            "args": {
              "type": "array",
              "items": {},
              "description": "Function arguments"
            },
            "field": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ],
              "description": "Output to select from a multi-value return: a named output or a zero-based index"
            },
            "max_age_seconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^(\\d+|\\$\\{[^}]+\\})$"
                }
              ]
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type",
            "function",
            "max_age_seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "conditional"
            },
            "condition": {
              "$ref": "#/definitions/Condition"
            },
            "then": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/StateEntry"
              }
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/StateEntry"
              }
            },
            "id": {
              "description": "Stable identifier shown in reports. Must be unique per contract.",
              "type": "string",
              "minLength": 1
            },
            "options": {
              "allOf": [
                {
                  "$ref": "#/definitions/Options"
                }
              ]
            },
            "metric": {
              "allOf": [
                {
                  "$ref": "#/definitions/Metric"
                }
              ]
            }
          },
          "required": [
            "type",
            "condition",
            "then"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Options": {
      "type": "object",
      "properties": {
        "comparison": {
          "description": "How the actual value is compared to `value` (default ==)",
          "type": "string",
          "enum": [
            "==",
            "!=",
            ">",
            ">=",
            "<",
            "<=",
            "equals",
            "not_equals",
            "greater_than",
            "greater_than_or_equal",
            "less_than",
            "less_than_or_equal"
          ]
        },
        "tolerance": {
          "description": "Allowed numeric deviation: absolute (\"1000\") or relative to `value` (\"0.5%\")",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        },
        "range": {
          "description": "Inclusive numeric bounds. Replaces `value`.",
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "number",
                "string"
              ]
            },
            "max": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          "additionalProperties": false
        },
        "pattern": {
          "description": "Regular expression the value must match. Replaces `value`.",
          "type": "string"
        },
        "ignore_case": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "^(true|false|\\$\\{[^}]+\\})$"
            }
          ]
        },
        "ignore_order": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "^(true|false|\\$\\{[^}]+\\})$"
            }
          ]
        },
        "decode_as": {
          "description": "storage_slot only: how to decode the slot",
          "type": "string",
          "enum": [
            "bytes32",
            "address",
            "uint256",
            "int256",
            "bool"
          ]
        },
        "offset": {
          "description": "storage_slot only: byte offset of a packed field, from the low-order end",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^(\\d+|\\$\\{[^}]+\\})$"
            }
          ]
        },
        "size": {
          "description": "storage_slot only: byte size of a packed field",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^(\\d+|\\$\\{[^}]+\\})$"
            }
          ]
        },
        "description": {
          "description": "Shown in reports",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Metric": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "integrity",
            "solvency",
            "liquidity",
            "risk",
            "supply",
            "governance"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
