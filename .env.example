# Copy to .env next to your config (or in the working directory).
# nodrift loads it automatically; variables already set in the environment take precedence.

# JSON-RPC endpoint used by ${RPC_URL} in the example configs.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Optional: lets `nodrift init` fetch verified ABIs (Etherscan V2 API, one key for all chains).
# ETHERSCAN_API_KEY=
