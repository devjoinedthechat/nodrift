# nodrift for GitLab CI: checks on-chain state and shows the results as test reports.
#
# 1. Add this job to .gitlab-ci.yml and nodrift.yaml to the repository root.
# 2. Add the RPC endpoint as a masked CI/CD variable named RPC_URL
#    (Settings > CI/CD > Variables).
# 3. For periodic drift detection, add a pipeline schedule (Build > Pipeline schedules).
#
# Exit codes: 0 in sync, 1 drift, 2 config error, 3 RPC error, 4 check error, 5 invalid config.

nodrift:
  image: node:22
  stage: test
  script:
    - npx nodrift@latest nodrift.yaml --fail-on-drift --output junit --junit-file test-results/nodrift.xml
  artifacts:
    when: always
    paths:
      - test-results/nodrift.xml
    reports:
      junit: test-results/nodrift.xml
