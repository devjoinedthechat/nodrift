# yaml-language-server: $schema=https://raw.githubusercontent.com/devjoinedthechat/nodrift/main/nodrift.schema.json
#
# nodrift starter config. Copy it to nodrift.yaml, then:
#   1. Set the variables used below, in the environment or in a .env file next to the config:
#      RPC_URL, TOKEN_ADDRESS, OWNER_ADDRESS, TREASURY_ADDRESS, MINTER_ADDRESS, IMPLEMENTATION_ADDRESS.
#   2. Replace the expected values with the state your contracts should have, and delete
#      the checks that do not apply.
#   3. nodrift validate nodrift.yaml   checks the config offline: schema, ABI lookups, value types
#   4. nodrift nodrift.yaml            reads the chain and reports drift
#
# Documentation: https://github.com/devjoinedthechat/nodrift/tree/main/docs

version: 1

network:
  rpc_url: "${RPC_URL}"     # HTTP(S) JSON-RPC endpoint
  chain_id: 1               # compared with the endpoint before anything is read
  # block: finalized        # latest (default), safe, finalized or a block number

contracts:
  Token:
    address: "${TOKEN_ADDRESS}"
    preset: erc20           # ABI for name, symbol, decimals, totalSupply, balanceOf, allowance
    abi:                    # further functions, as human-readable signatures
      - "function paused() view returns (bool)"
    state:
      # Ownable: reads owner(), or getOwner() if owner() is missing.
      - type: owner
        value: "${OWNER_ADDRESS}"
        metric: { name: token_owner, category: integrity, severity: critical }

      # Functions without arguments. Expected values are converted to the return type.
      - type: variable
        name: symbol
        value: TKN

      - type: variable
        name: decimals
        value: 18

      - type: variable
        name: paused
        value: false

      # A value that may move a little: 1,000,000 tokens with 18 decimals, plus or minus 1%.
      - type: variable
        id: supply
        name: totalSupply
        value: "1000000 ether"
        options:
          tolerance: "1%"
          description: total supply within 1% of 1M

      # Functions with arguments, and a lower bound instead of an exact value.
      - type: function_call
        function: balanceOf
        args: ["${TREASURY_ADDRESS}"]
        value: "100000 ether"
        options:
          comparison: ">="

      # OpenZeppelin AccessControl: hasRole(keccak256("MINTER_ROLE"), account) must be true.
      - type: role
        role: MINTER_ROLE
        account: "${MINTER_ADDRESS}"

      # ERC-1967 proxy: the implementation slot. Delete this check if the token is not a proxy.
      - type: proxy
        checks:
          implementation: "${IMPLEMENTATION_ADDRESS}"
