# nodrift for GitHub Actions: checks on-chain state on pushes to main, on pull requests,
# every 6 hours and on demand.
#
# 1. Copy this file to .github/workflows/nodrift.yml and nodrift.yaml to the repository root.
# 2. Add the RPC endpoint as a repository secret named RPC_URL
#    (Settings > Secrets and variables > Actions).
#
# Pull requests from forks do not receive secrets; nodrift then exits with code 2.
# Exit codes: 0 in sync, 1 drift, 2 config error, 3 RPC error, 4 check error, 5 invalid config.

name: nodrift

on:
  push:
    branches: [main]
  pull_request:
  schedule:
    - cron: "0 */6 * * *"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-node@v7
        with:
          node-version: 22

      # Pin a commit for reproducible runs: github:devjoinedthechat/nodrift#<commit>
      - name: Install nodrift
        run: npm install --global github:devjoinedthechat/nodrift

      - name: Check on-chain state
        run: nodrift nodrift.yaml --fail-on-drift --output junit --junit-file test-results/nodrift.xml
        env:
          RPC_URL: ${{ secrets.RPC_URL }}

      # Runs after drift or check errors too. There is no report when the run stopped early
      # (exit code 2, 3 or 5); the step then only warns.
      - name: Upload JUnit report
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: nodrift-report
          path: test-results/nodrift.xml
